#!/usr/bin/env bash
set -euo pipefail

if [[ ! -r /etc/os-release ]]; then
  echo "Cannot detect operating system; cannot install the Ubuntu APT packages." >&2
  exit 1
fi

. /etc/os-release
if [[ "${ID:-}" != ubuntu ]]; then
  echo "This package manifest targets Ubuntu (found ${ID:-unknown}); refusing to continue." >&2
  exit 1
fi

packages=(
{{- range .packages.ubuntu.common }}
  {{ . | quote }}
{{- end }}
{{- range index .packages.ubuntu .profile }}
  {{ . | quote }}
{{- end }}
)

if (( EUID == 0 )); then
  apt_get=(apt-get)
else
  if ! command -v sudo >/dev/null 2>&1; then
    echo "sudo is required to install Ubuntu packages." >&2
    exit 1
  fi
  apt_get=(sudo apt-get)
fi

"${apt_get[@]}" update
"${apt_get[@]}" install --yes --no-install-recommends "${packages[@]}"
