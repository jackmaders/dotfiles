#!/usr/bin/env bash
set -euo pipefail

if [[ ! -r /etc/os-release ]]; then
  echo "Cannot detect operating system; cannot install Bun." >&2
  exit 1
fi

. /etc/os-release
if [[ "${ID:-}" != ubuntu ]]; then
  echo "Bun installation targets Ubuntu (found ${ID:-unknown}); refusing to continue." >&2
  exit 1
fi

bun_install_dir="${BUN_INSTALL:-$HOME/.bun}"
bun_binary="$bun_install_dir/bin/bun"
if [[ -x "$bun_binary" ]] && "$bun_binary" --version >/dev/null 2>&1; then
  exit 0
fi

if ! command -v curl >/dev/null 2>&1; then
  echo "curl is unavailable; cannot install Bun." >&2
  exit 1
fi

export BUN_INSTALL="$bun_install_dir"
curl -fsSL https://bun.sh/install | bash

if [[ ! -x "$bun_binary" ]]; then
  echo "The Bun installer did not create an executable at $bun_binary." >&2
  exit 1
fi

"$bun_binary" --version >/dev/null
