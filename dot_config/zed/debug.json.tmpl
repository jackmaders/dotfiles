{{- if .godotPath }}
[
  {
    "label": "Run Godot .NET project",
    "adapter": "netcoredbg",
    "request": "launch",
    "program": {{ .godotPath | quote }},
    "args": ["--path", "${ZED_WORKTREE_ROOT}"],
    "cwd": "${ZED_WORKTREE_ROOT}",
    "build": {
      "command": "dotnet",
      "args": ["build", "${ZED_WORKTREE_ROOT}"]
    }
  }
]
{{- end }}
