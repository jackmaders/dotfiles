# Read by every zsh process, including non-interactive shells.
# Keep this file quiet and limited to environment and startup-path setup.

export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"

typeset -U path PATH
path=("$HOME/.local/bin" "$HOME/.hunk/bin" $path)

# Make managed runtimes and global packages available to non-interactive shells.
if [[ -r "${VP_HOME:-$XDG_CONFIG_HOME/vite-plus}/env" ]]; then
  source "${VP_HOME:-$XDG_CONFIG_HOME/vite-plus}/env" || {
    print -u2 -- "Failed to load Vite+ environment."
    return 1
  }
fi

# Make the selected chezmoi profile available to other shell tools.
export DOTFILES_PROFILE={{ .profile | quote }}
