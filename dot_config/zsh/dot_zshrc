# Interactive shell configuration.
fzf_tab_plugin="$HOME/.local/share/zsh/plugins/fzf-tab/fzf-tab.plugin.zsh"
zsh_autosuggestions=/usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh
fzf_key_bindings=/usr/share/doc/fzf/examples/key-bindings.zsh
fzf_completion=/usr/share/doc/fzf/examples/completion.zsh
zsh_syntax_highlighting=/usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

setopt interactivecomments

# History lives in XDG data and is shared between interactive shells.
HISTFILE="${XDG_DATA_HOME}/zsh/zsh_history"
HISTSIZE=50000
SAVEHIST=50000
if [[ ! -d "${HISTFILE:h}" ]] && ! command mkdir -p -- "${HISTFILE:h}"; then
  print -u2 -- "Cannot create Zsh history directory: ${HISTFILE:h}"
  return 1
fi
if [[ ! -w "${HISTFILE:h}" ]]; then
  print -u2 -- "Zsh history directory is not writable: ${HISTFILE:h}"
  return 1
fi
setopt sharehistory hist_ignore_dups hist_ignore_space hist_expire_dups_first

# Ctrl+Left / Ctrl+Right and history prefix search.
bindkey '^[[1;5D' backward-word
bindkey '^[[1;5C' forward-word
bindkey '^[OA' history-beginning-search-backward
bindkey '^[OB' history-beginning-search-forward

# Completion and its generated cache.
typeset -g ZSH_CACHE_DIR="${XDG_CACHE_HOME}/zsh"
if [[ ! -d "$ZSH_CACHE_DIR" ]] && ! command mkdir -p -- "$ZSH_CACHE_DIR"; then
  print -u2 -- "Cannot create Zsh cache directory: $ZSH_CACHE_DIR"
  return 1
fi
if [[ ! -w "$ZSH_CACHE_DIR" ]]; then
  print -u2 -- "Zsh cache directory is not writable: $ZSH_CACHE_DIR"
  return 1
fi
autoload -Uz compinit
compinit -d "$ZSH_CACHE_DIR/zcompdump-${ZSH_VERSION}" || {
  print -u2 -- "Failed to initialize Zsh completion."
  return 1
}

# fzf-tab must load after compinit and before widgets wrapped by other plugins.
source "$fzf_tab_plugin" || { print -u2 -- "Failed to load fzf-tab."; return 1; }
source "$zsh_autosuggestions" || { print -u2 -- "Failed to load zsh-autosuggestions."; return 1; }
source "$fzf_key_bindings" || { print -u2 -- "Failed to load fzf key bindings."; return 1; }
source "$fzf_completion" || { print -u2 -- "Failed to load fzf completion."; return 1; }

_dotfiles_init() {
  local init_code
  init_code="$("$@")" || { print -u2 -- "Failed to initialize $1."; return 1; }
  eval "$init_code" || { print -u2 -- "Failed to apply $1 initialization."; return 1; }
}
# Reload after compinit to register Vite+ completions.
if [[ -r "${VP_HOME:-$XDG_CONFIG_HOME/vite-plus}/env" ]]; then
  source "${VP_HOME:-$XDG_CONFIG_HOME/vite-plus}/env" || {
    print -u2 -- "Failed to load Vite+ environment."
    return 1
  }
fi

_dotfiles_init direnv hook zsh || return 1
_dotfiles_init zoxide init zsh || return 1
alias cd=z

_dotfiles_init starship init zsh || return 1
unfunction _dotfiles_init

# Preserve the old shortcuts while accounting for Ubuntu binary names.
alias c='clear'
alias ..='cd ..'
alias ...='cd ../..'
alias grep='rg'

if (( $+commands[bat] )); then
  alias cat='bat -p'
else
  alias cat='batcat -p'
fi

if (( $+commands[fd] )); then
  alias find='fd'
else
  alias find='fdfind'
fi

alias tree='eza --tree --icons'

# Local-only overrides stay outside chezmoi.
if [[ -r "$HOME/.zshrc.local" ]]; then
  source "$HOME/.zshrc.local" || {
    print -u2 -- "Failed to load $HOME/.zshrc.local."
    return 1
  }
fi

# Do not let WSL resolve Node tools from the Windows fnm/npm installations.
if [[ -n "${WSL_DISTRO_NAME:-}" ]]; then
  path=(${path:#*/AppData/Roaming/npm})
  path=(${path:#*/AppData/Roaming/fnm/node-versions/*})
  path=(${path:#*/AppData/Local/fnm_multishells/*})
  rehash
fi

# Keep syntax highlighting last so it can wrap the final line editor widgets.
source "$zsh_syntax_highlighting" || {
  print -u2 -- "Failed to load zsh-syntax-highlighting."
  return 1
}
unset fzf_tab_plugin zsh_autosuggestions fzf_key_bindings fzf_completion zsh_syntax_highlighting
