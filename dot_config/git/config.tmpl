[init]
	defaultBranch = main

[pull]
	rebase = true

[user]
	name = {{ .gitName | quote }}
	email = {{ .gitEmail | quote }}
{{ if and (eq .profile "twinkl") .gitSigningKey }}
	signingKey = {{ .gitSigningKey | quote }}

[commit]
	gpgsign = true

[gpg]
	format = ssh

[tag]
	gpgsign = true
{{ end }}

[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	line-numbers = true
	side-by-side = false
