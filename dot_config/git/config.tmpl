[init]
	defaultBranch = main

[pull]
	rebase = true

[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	line-numbers = true
	side-by-side = false

[user]
	name = {{ .gitName | quote }}
	email = {{ .gitEmail | quote }}
{{ if eq .profile "twinkl" -}}
	signingKey = {{ printf "%s/.ssh/id_ed25519.pub" .chezmoi.homeDir | quote }}

[gpg]
	format = ssh
{{ end }}
[commit]
	gpgsign = {{ eq .profile "twinkl" }}

[tag]
	gpgsign = {{ eq .profile "twinkl" }}
