#!/usr/bin/env bash
set -euo pipefail

if [[ ! -r /etc/os-release ]]; then
  echo "Cannot detect operating system; cannot install Obsidian." >&2
  exit 1
fi

. /etc/os-release
if [[ "${ID:-}" != ubuntu ]]; then
  echo "Obsidian installation targets Ubuntu (found ${ID:-unknown}); refusing to continue." >&2
  exit 1
fi

if ! command -v curl >/dev/null 2>&1; then
  echo "curl is unavailable; cannot install Obsidian." >&2
  exit 1
fi

case "$(dpkg --print-architecture)" in
  amd64)
    download_url="https://obsidian.md/download?platform=linux&arch=x64&package=deb"
    ;;
  *)
    echo "The official Obsidian .deb installer is available for amd64; found $(dpkg --print-architecture)." >&2
    exit 1
    ;;
esac

download_dir="$(mktemp -d)"
cleanup() {
  rm -rf -- "$download_dir"
}
trap cleanup EXIT

deb_file="$download_dir/obsidian.deb"
curl --fail --location --silent --show-error "$download_url" --output "$deb_file"
if ! dpkg-deb --info "$deb_file" >/dev/null 2>&1; then
  echo "The Obsidian download did not contain a valid Debian package." >&2
  exit 1
fi

if (( EUID == 0 )); then
  apt_get=(apt-get)
else
  if ! command -v sudo >/dev/null 2>&1; then
    echo "sudo is required to install Obsidian." >&2
    exit 1
  fi
  apt_get=(sudo apt-get)
fi

"${apt_get[@]}" install --yes --no-install-recommends "$deb_file"

if ! command -v obsidian >/dev/null 2>&1; then
  echo "The Obsidian .deb package did not install the obsidian command." >&2
  exit 1
fi
