#!/usr/bin/env bash
set -euo pipefail

export PATH="$HOME/.local/bin:$PATH"
export BUN_INSTALL="${BUN_INSTALL:-$HOME/.bun}"
export PATH="$BUN_INSTALL/bin:$PATH"

require_command() {
  local command_name="$1"
  local expected_source="$2"

  if ! command -v "$command_name" >/dev/null 2>&1; then
    echo "Required command '$command_name' is unavailable after installation; expected '$expected_source'." >&2
    exit 1
  fi
}

require_one_of() {
  local command_names="$1"
  local expected_source="$2"
  shift 2

  for command_name in "$@"; do
    if command -v "$command_name" >/dev/null 2>&1; then
      return 0
    fi
  done

  echo "Required command '$command_names' is unavailable after installation; expected '$expected_source'." >&2
  exit 1
}

require_command fnm "the fnm installer"
require_command chezmoi "the chezmoi binary installer"
require_command bun "the Bun installer"
require_command herdr "the Herdr installer"
require_command claude "the Claude Code installer"
require_command agy "the Antigravity CLI installer"
require_command obsidian "the Obsidian .deb package"
require_command direnv direnv
require_command zoxide zoxide
require_command starship starship
require_command clear ncurses-bin
require_command rg ripgrep
require_command eza eza
require_one_of "bat or batcat" bat bat batcat
require_one_of "fd or fdfind" fd-find fd fdfind

if ! "$HOME/.local/bin/fnm" exec --using=lts/latest pnpm --version >/dev/null 2>&1; then
  echo "Required command 'pnpm' is unavailable under the latest Node.js LTS; expected the pnpm installer." >&2
  exit 1
fi
